# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# Security & CORS (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# JWT Configuration
# Generate secure 64+ character keys in production: `openssl rand -base64 48`
JWT_ACCESS_SECRET=super_secret_jwt_access_token_encryption_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_encryption_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security
COOKIE_SECRET=session_cookie_signing_secret_random_secure_bytes_for_tamper_proofing_123

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info

# Storage Path (JSON persistent database)
DATA_DIR=./data
